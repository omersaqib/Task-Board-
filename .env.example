# ---------- Backend (backend/.env or exported in the shell) ----------
# Port the API listens on
PORT=3001
# SQLite database file. Use ":memory:" for a throwaway database.
DATABASE_PATH=./data/taskboard.db
# Secret used to sign JWTs. REQUIRED when NODE_ENV=production (min 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Token lifetime (seconds)
TOKEN_TTL_SECONDS=3600
# Allowed browser origin(s) for CORS, comma-separated. Not needed when the
# frontend proxies /api (the default for dev, preview and docker-compose).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
NODE_ENV=development

# ---------- Frontend (Vite) ----------
# Where the Vite dev/preview server proxies /api requests.
API_PROXY_TARGET=http://localhost:3001

# ---------- Playwright ----------
# URL of the running frontend under test
E2E_BASE_URL=http://localhost:4173
# URL of the running API (used for health checks and API-level tests)
E2E_API_URL=http://localhost:3001
# Set to 1 when the services are started externally (as in CI)
PW_SKIP_WEBSERVER=0
